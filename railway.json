{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "rootDirectory": "app"
  },
  "deploy": {
    "startCommand": "php artisan storage:link && php artisan optimize && php artisan serve --host=0.0.0.0 --port=$PORT",
    "healthcheckPath": "/up",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
